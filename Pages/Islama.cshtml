@page
@model IslamaModel
@{ViewData["Title"]="Islama · Soyma";}
@if(Model.ErrorMessage is not null){<div class="notice error">@Model.ErrorMessage</div>}
<div class="@(Model.IsAdmin?"workspace-grid":"personnel-entry")">
@if(Model.IsAdmin){
<section class="data-section"><div class="section-head"><div><h2>Kayıtlar</h2><p>Son 100 ıslama-soyma işlemi</p></div><span class="count-badge">@Model.Records.Count kayıt</span></div><partial name="Shared/_RecordFilter" model="Model.Filter"/><div class="table-wrap"><table class="data-table"><thead><tr><th>Parti</th><th>Tarih</th><th>Menşei · Ürün</th><th>Silo</th><th class="num">Çekilen</th><th class="num">Süre</th><th></th></tr></thead><tbody>
@foreach(var x in Model.Records){<tr><td><strong>@x.PartiNo</strong></td><td>@x.SoymaBitisi.ToString("dd.MM.yyyy HH:mm")</td><td>@x.Mensei<br/><small>@x.Urun</small></td><td>@(x.Silo??"—")</td><td class="num"><strong>@x.CekilenTonajKg.ToString("0.###") kg</strong></td><td class="num">@x.SoymaSuresiDakika dk</td><td>@if(Model.IsAdmin){<div class="table-actions"><a class="action-edit" asp-route-editId="@x.Id">Düzenle</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bu kayıt silinsin mi?');"><input type="hidden" name="id" value="@x.Id"/><button class="action-delete">Sil</button></form></div>}</td></tr>}
@if(Model.Records.Count==0){<tr><td colspan="7" class="empty">Henüz görüntülenecek kayıt yok.</td></tr>}
</tbody></table></div></section>}
<aside class="entry-panel"><div class="panel-head"><h2>@(Model.EditId is>0?"Kaydı düzenle":Model.IsAdmin?"Yeni kayıt":"Görev kaydı")</h2><span>@(Model.IsAdmin?"Islama · Soyma":Model.PersonnelName)</span></div><form method="post" class="entry-form"><input asp-for="EditId" type="hidden"/><div asp-validation-summary="All" class="validation"></div>
@if(Model.EditId is>0){<div class="edit-banner"><span>#@Model.EditId numaralı kayıt düzenleniyor</span><a asp-page="/Islama">İptal</a></div>}
<div class="field-row"><label>Parti no (otomatik)<input asp-for="Input.PartiNo" readonly data-persisted="@(Model.EditId is > 0 ? "true" : "false")"/></label><label>Barkod seri<input asp-for="Input.BarkodSeri"/></label></div>
<div class="field-row"><label>Ham susam geliş<input asp-for="Input.HamSusamGelisTarihi" type="date"/></label><label>Nöbet tarihi<input asp-for="Input.NobetTarihi" type="date"/></label></div>
<div class="field-row"><label>Islama başlangıcı<input asp-for="Input.IslamaBaslangici" type="datetime-local"/></label><label>Islama bitişi<input asp-for="Input.IslamaBitisi" type="datetime-local"/></label></div>
<div class="field-row"><label>Soyma başlangıcı<input asp-for="Input.SoymaBaslangici" type="datetime-local"/></label><label>Soyma bitişi<input asp-for="Input.SoymaBitisi" type="datetime-local"/></label></div>
<div class="field-row"><label>Menşei<select asp-for="Input.MenseiId"><option value="">Seçin</option>@foreach(var x in Model.Menseiler){<option value="@x.Id">@x.Name</option>}</select></label><label>Ürün<select asp-for="Input.UrunId"><option value="">Seçin</option>@foreach(var x in Model.Urunler){<option value="@x.Id">@x.Name</option>}</select></label></div>
<div class="field-row"><label>Silo 1 <span>A1-A4, B1-B4 veya C1-C4</span><input asp-for="Input.Silo1" maxlength="2" placeholder="Örn. A1" pattern="[A-Ca-c][1-4]" title="Uygun formatta girin: A1-A4, B1-B4 veya C1-C4."/><span asp-validation-for="Input.Silo1" class="validation"></span></label><label>Silo 2 <span>A1-A4, B1-B4 veya C1-C4</span><input asp-for="Input.Silo2" maxlength="2" placeholder="Örn. B1" pattern="[A-Ca-c][1-4]" title="Uygun formatta girin: A1-A4, B1-B4 veya C1-C4."/><span asp-validation-for="Input.Silo2" class="validation"></span></label></div>
@if(Model.IsAdmin){<label>Personel<select asp-for="Input.PersonelId"><option value="">Seçin</option>@foreach(var x in Model.Personeller){<option value="@x.Id">#@x.Id · @x.Name</option>}</select></label>}
<div class="field-row"><label>Çöp <span>kg</span><input asp-for="Input.CopKg" type="number" step="0.001"/></label><label>Ekran tonajı <span>kg</span><input asp-for="Input.EkranTonajiKg" type="number" step="0.001"/></label></div>
<label>Çekilen tonaj <span>kg · elle girin</span><input asp-for="Input.CekilenTonajKg" type="text" inputmode="decimal" placeholder="Örn. 56200" autocomplete="off"/></label><label>Açıklama<textarea asp-for="Input.Aciklama" rows="2"></textarea></label><button class="btn-primary-app full">@(Model.EditId is>0?"Değişiklikleri kaydet":"Kaydı ekle")</button></form></aside></div>
