@page
@model CopModel
@{ViewData["Title"]="Giriş Eleme Çöpü";}

@if(Model.ErrorMessage is not null){<div class="notice error">@Model.ErrorMessage</div>}

<div class="@(Model.IsAdmin?"workspace-grid":"personnel-entry")">
    <section class="data-section">
        <div class="section-head"><div><h2>Giriş eleme çöpü kayıtları</h2><p>Fabrikaya giriş öncesi elemede çıkan çöp</p></div><span class="count-badge">@Model.Records.Count kayıt</span></div>
        <div class="table-wrap"><table class="data-table">
            <thead><tr><th>Tarih</th><th>Menşei</th><th class="num">Giriş eleme çöpü</th><th></th></tr></thead>
            <tbody>
            @foreach(var x in Model.Records)
            {
                <tr><td><strong>@x.Tarih.ToString("dd.MM.yyyy")</strong></td><td>@x.Mensei</td><td class="num"><strong>@x.CopKg.ToString("0.###") kg</strong></td><td><div class="table-actions"><a class="action-edit" asp-route-editId="@x.Id">Düzenle</a>@if(Model.IsAdmin||x.Id==Model.Records.FirstOrDefault()?.Id){<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bu çöp kaydı silinsin mi?');"><input type="hidden" name="id" value="@x.Id"/><button class="action-delete">Sil</button></form>}</div></td></tr>
            }
            </tbody>
        </table></div>
    </section>
    <aside class="entry-panel">
        <div class="panel-head"><h2>@(Model.EditId is>0?"Giriş eleme çöpü kaydını düzenle":"Yeni giriş eleme çöpü kaydı")</h2><span>Yalnızca SQL</span></div>
        <form method="post" class="entry-form">
            <input asp-for="EditId" type="hidden"/>
            <div asp-validation-summary="All" class="validation"></div>
            @if(Model.EditId is>0){<div class="edit-banner"><span>#@Model.EditId numaralı kayıt düzenleniyor</span><a asp-page="/Cop">İptal</a></div>}
            <label>Tarih<input asp-for="Input.Tarih" type="date"/></label>
            <label>Menşei<select asp-for="Input.MenseiId"><option value="">Seçin</option>@foreach(var x in Model.Menseiler){<option value="@x.Id">@x.Name</option>}</select></label>
            <label>Giriş eleme çöpü <span>kg</span><input asp-for="Input.CopKg" type="number" min="0.001" step="0.001"/></label>
            <button class="btn-primary-app full">@(Model.EditId is>0?"Değişiklikleri kaydet":"SQL'e kaydet")</button>
        </form>
    </aside>
</div>
