@page
@model PersonelSecModel
@{Layout=null;}
<!DOCTYPE html><html lang="tr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Personel Seçimi · Üretim Yönetim Sistemi</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body class="access-body"><main class="access-card personnel-select-card"><a class="access-back" asp-page="/Giris">← Panel seçimine dön</a><div class="access-heading"><span>Personel paneli</span><h1>Kim olduğunuzu seçin</h1><p>Çalışacağınız görevi seçerek kayıt ekranına geçin.</p></div>@if(Model.ErrorMessage is not null){<div class="notice error">@Model.ErrorMessage</div>}<div class="personnel-grid">@foreach(var person in Model.Personnel){<div class="person-card"><span class="person-id">#@person.PersonelId</span><strong>@person.Name</strong>@if(person.Tasks.Count==0){<small>Görev atanmamış</small>}<div class="person-task-buttons">@foreach(var task in person.Tasks){<form method="post"><input type="hidden" name="personnelId" value="@person.PersonelId"/><input type="hidden" name="taskNumber" value="@task.TaskNumber"/><button type="submit">@task.TaskName →</button></form>}</div></div>}</div>@if(Model.Personnel.Count==0){<div class="empty-state">Aktif personel bulunamadı.</div>}</main></body></html>
