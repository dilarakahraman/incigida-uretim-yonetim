@page
@model KepekModel
@{ViewData["Title"]="Kurutulmuş Kepek";}
@if(Model.ErrorMessage is not null){<div class="notice error">@Model.ErrorMessage</div>}
<div class="@(Model.IsAdmin?"workspace-grid":"personnel-entry")">@if(Model.IsAdmin){<section class="data-section"><div class="section-head"><div><h2>Kayıtlar</h2><p>Son 100 kepek işlemi</p></div><span class="count-badge">@Model.Records.Count kayıt</span></div><partial name="Shared/_RecordFilter" model="Model.Filter"/><div class="table-wrap"><table class="data-table"><thead><tr><th>Parti</th><th>Tarih</th><th>Ürün cinsi</th><th class="num">Miktar</th><th class="num">Ham susama oran</th><th></th></tr></thead><tbody>@foreach(var x in Model.Records){<tr><td><strong>@(x.PartiNo??"—")</strong></td><td>@(x.Tarih?.ToString("dd.MM.yyyy")??"—")</td><td>@(x.UrunCinsi??"—")</td><td class="num"><strong>@x.MiktarKg.ToString("0.###") kg</strong></td><td class="num">@(x.HamSusamaOrani?.ToString("0.####")??"—")</td><td><div class="table-actions"><a class="action-edit" asp-route-editId="@x.Id">Düzenle</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bu kayıt silinsin mi?');"><input type="hidden" name="id" value="@x.Id"/><button class="action-delete">Sil</button></form></div></td></tr>}</tbody></table></div></section>}
<aside class="entry-panel"><div class="panel-head"><h2>@(Model.EditId is>0?"Kaydı düzenle":Model.IsAdmin?"Yeni kayıt":"Görev kaydı")</h2><span>@(Model.IsAdmin?"Kurutulmuş kepek":Model.PersonnelName)</span></div><form method="post" class="entry-form"><input asp-for="EditId" type="hidden"/><div asp-validation-summary="ModelOnly" class="validation"></div>@if(Model.EditId is>0){<div class="edit-banner"><span>#@Model.EditId numaralı kayıt düzenleniyor</span><a asp-page="/Kepek">İptal</a></div>}<div class="field-row"><label>Tarih<input asp-for="Input.Tarih" type="date"/></label><label>Parti no<input asp-for="Input.PartiNo"/></label></div><div class="field-row"><label>Paketleme miktarı <span>kg</span><input asp-for="Input.PaketlemeMiktariKg" type="number" step="0.001"/></label><label>Ürün cinsi<input asp-for="Input.UrunCinsi"/></label></div><div class="field-row"><label>Personel sayısı<input asp-for="Input.PersonelSayisi" type="number"/></label><label>Ham susama oran<input asp-for="Input.HamSusamaOrani" type="number" step="0.0001"/></label></div>@if(Model.IsAdmin){<label>Personel<select asp-for="Input.PersonelId"><option value="">Seçin</option>@foreach(var x in Model.Personeller){<option value="@x.Id">#@x.Id · @x.Name</option>}</select></label>}<label>Açıklama<textarea asp-for="Input.Aciklama" rows="3"></textarea></label><button class="btn-primary-app full">@(Model.EditId is>0?"Değişiklikleri kaydet":"Kaydı ekle")</button></form></aside></div>
