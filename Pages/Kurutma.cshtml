@page
@model KurutmaModel
@{ViewData["Title"]="Kurutma";}
@if(Model.ErrorMessage is not null){<div class="notice error">@Model.ErrorMessage</div>}

@if(Model.IsAdmin)
{
<section class="data-section shift-history">
    <div class="section-head"><div><h2>Kurutma nöbetleri</h2><p>Son 100 nöbet ve satır toplamları</p></div><span class="count-badge">@Model.Records.Count nöbet</span></div>
    <div class="table-wrap"><table class="data-table">
        <thead><tr><th>Tarih</th><th>Nöbet</th><th>Personel</th><th class="num">Satır</th><th class="num">Yıkama</th><th class="num">Kireç</th><th class="num">Makine</th><th>Açıklama</th><th></th></tr></thead>
        <tbody>
        @foreach(var x in Model.Records)
        {
            <tr><td><strong>@x.Tarih.ToString("dd.MM.yyyy")</strong></td><td>@x.Nobet</td><td>@x.Personel</td><td class="num">@x.SatirSayisi</td><td class="num">@x.YikamaSayisi</td><td class="num">@x.KirecKg.ToString("0.###") kg</td><td class="num">@x.MakineSayisi</td><td>@(x.Aciklama??"—")</td><td class="num"><form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bu nöbet ve bağlı tüm kurutma satırları silinsin mi?');"><input type="hidden" name="id" value="@x.Id"/><button class="action-delete">Sil</button></form></td></tr>
        }
        </tbody>
    </table></div>
</section>
}

<section class="data-section sheet-entry-section" data-grid-editor>
    <div class="section-head"><div><h2>Yeni kurutma nöbeti</h2><p>Excel gibi satır ekleyin; kaydederken SQL'e normal detay kayıtları yazılır</p></div><span class="count-badge">Ortak açıklama</span></div>
    <form method="post" class="sheet-entry-form">
        <div asp-validation-summary="All" class="validation sheet-validation"></div>
        <div class="shift-header-fields">
            <label>Tarih<input asp-for="Input.Tarih" type="date"/></label>
            <label>Nöbet<select asp-for="Input.Nobet">
                <option>07:00 - 15:00</option>
                <option>15:00 - 23:00</option>
                <option>23:00 - 07:00</option>
                <option>08:00 - 20:00</option>
                <option>20:00 - 08:00</option>
            </select></label>
            @if(Model.IsAdmin)
            {
                <label>Kurutma personeli<select asp-for="Input.PersonelId"><option value="">Seçin</option>@foreach(var person in Model.Personeller){<option value="@person.Id">#@person.Id · @person.Name</option>}</select></label>
            }
            else
            {
                <label>Kurutma personeli<input value="@Model.PersonnelName" disabled/></label>
            }
            <label class="shift-note">Ortak açıklama<textarea asp-for="Input.Aciklama" rows="2" placeholder="Bu nöbetteki bütün satırlar için ortak açıklama"></textarea></label>
        </div>
        <div class="spreadsheet-wrap">
            <table class="spreadsheet-entry-table">
                <thead><tr><th>#</th><th>Menşei</th><th>Cinsi</th><th>Yıkama sayısı</th><th>Kireç (kg)</th><th>Makine sayısı</th><th></th></tr></thead>
                <tbody data-grid-rows>
                @for(var i=0;i<Model.Input.Satirlar.Count;i++)
                {
                    <tr data-grid-row>
                        <td class="row-number">@(i+1)</td>
                        <td><select asp-for="Input.Satirlar[i].MenseiId"><option value="">Seçin</option>@foreach(var origin in Model.Menseiler){<option value="@origin.Id">@origin.Name</option>}</select></td>
                        <td><select asp-for="Input.Satirlar[i].UrunId"><option value="">Seçin</option>@foreach(var product in Model.Urunler){<option value="@product.Id">@product.Name</option>}</select></td>
                        <td><input asp-for="Input.Satirlar[i].YikamaSayisi" type="number" min="0" step="1"/></td>
                        <td><input asp-for="Input.Satirlar[i].KirecKg" type="number" min="0" step="0.001"/></td>
                        <td><input asp-for="Input.Satirlar[i].MakineSayisi" type="number" min="0" step="1"/></td>
                        <td><button type="button" class="grid-row-delete" data-grid-remove aria-label="Satırı sil">×</button></td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><td colspan="3">Toplam</td><td data-sum-column="YikamaSayisi">0</td><td data-sum-column="KirecKg">0</td><td data-sum-column="MakineSayisi">0</td><td></td></tr></tfoot>
            </table>
        </div>
        <template data-grid-template>
            <tr data-grid-row>
                <td class="row-number">__number__</td>
                <td><select name="Input.Satirlar[__index__].MenseiId" required><option value="">Seçin</option>@foreach(var origin in Model.Menseiler){<option value="@origin.Id">@origin.Name</option>}</select></td>
                <td><select name="Input.Satirlar[__index__].UrunId" required><option value="">Seçin</option>@foreach(var product in Model.Urunler){<option value="@product.Id">@product.Name</option>}</select></td>
                <td><input name="Input.Satirlar[__index__].YikamaSayisi" type="number" min="0" step="1" required/></td>
                <td><input name="Input.Satirlar[__index__].KirecKg" type="number" min="0" step="0.001" required/></td>
                <td><input name="Input.Satirlar[__index__].MakineSayisi" type="number" min="0" step="1" required/></td>
                <td><button type="button" class="grid-row-delete" data-grid-remove aria-label="Satırı sil">×</button></td>
            </tr>
        </template>
        <div class="sheet-form-actions"><button type="button" class="btn-grid-add" data-grid-add>+ Satır ekle</button><button class="btn-primary-app" type="submit">Kaydet</button></div>
    </form>
</section>
