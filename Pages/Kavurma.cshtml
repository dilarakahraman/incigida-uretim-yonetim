@page
@model KavurmaModel
@{ ViewData["Title"] = "Kavurma"; }

@if (Model.ErrorMessage is not null) { <div class="notice error">@Model.ErrorMessage</div> }

<div class="@(Model.IsAdmin ? "workspace-grid" : "personnel-entry")">
    <section class="data-section">
        <div class="section-head">
            <div><h2>Kavurma kayıtları</h2><p>Kayıtlar sayfalar hâlinde gösterilir</p></div>
            <span class="count-badge">@Model.Records.Count kayıt</span>
        </div>
        <partial name="Shared/_RecordFilter" model="Model.Filter"/>
        <div class="table-wrap"><table class="data-table">
            <thead><tr><th>Parti</th><th>Tarih</th><th>Kavuran</th><th class="num">Sıcaklık</th><th class="num">Nişasta</th><th class="num">Kepek</th><th>Ürün</th><th class="num">Net tonaj</th><th class="num">Tava sayısı</th><th></th></tr></thead>
            <tbody>
            @foreach (var x in Model.Records)
            {
                <tr>
                    <td><strong>@(x.PartiNo ?? "—")</strong></td>
                    <td>@(x.Tarih?.ToString("dd.MM.yyyy") ?? "—")</td>
                    <td>@(x.Personel ?? "—")</td>
                    <td class="num">@(x.KavurmaSicakligi?.ToString("0.##") ?? "—") °C</td>
                    <td class="num">@(x.NisastaKg?.ToString("0.###") ?? "—") kg</td>
                    <td class="num">@(x.KepekKg?.ToString("0.###") ?? "—") kg</td>
                    <td>@(x.Urun ?? "—")</td>
                    <td class="num"><strong>@x.NetTonajKg.ToString("0.###") kg</strong></td>
                    <td class="num">@(x.TavaSayisi?.ToString() ?? "—")</td>
                    <td><div class="table-actions"><a class="action-edit" asp-route-editId="@x.Id">Düzenle</a>@if(Model.IsAdmin||x.Id==Model.Records.FirstOrDefault()?.Id){<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bu kayıt silinsin mi?');"><input type="hidden" name="id" value="@x.Id"/><button class="action-delete">Sil</button></form>}</div></td>
                </tr>
            }
            </tbody>
        </table></div>
        <partial name="Shared/_Pagination" model="@(new PaginationViewModel(Model.Filter,Model.HasNextPage))"/>
    </section>
    <aside class="entry-panel">
        <div class="panel-head"><h2>@(Model.EditId is > 0 ? "Kavurma kaydını düzenle" : Model.IsAdmin ? "Yeni kavurma kaydı" : "Kavurma görev kaydı")</h2><span>@(Model.IsAdmin ? "Kavurma" : Model.PersonnelName)</span></div>
        <form method="post" class="entry-form">
            <input asp-for="EditId" type="hidden"/>
            <div asp-validation-summary="All" class="validation"></div>
            @if (Model.EditId is > 0) { <div class="edit-banner"><span>#@Model.EditId numaralı kayıt düzenleniyor</span><a asp-page="/Kavurma">İptal</a></div> }
            <div class="field-row"><label>Tarih<input asp-for="Input.Tarih" type="date"/></label><label>Parti no<input asp-for="Input.PartiNo"/></label></div>
            <div class="field-row"><label>Ekran tonajı <span>kg</span><input asp-for="Input.EkranTonajiKg" type="number" step="0.001"/></label><label>Net tonaj <span>kg</span><input asp-for="Input.NetTonajKg" type="number" step="0.001"/></label></div>
            <div class="field-row"><label>Kavurma sıcaklığı <span>°C</span><input asp-for="Input.KavurmaSicakligi" type="number" min="0" step="0.01"/></label><label>Nişasta <span>kg</span><input asp-for="Input.NisastaKg" type="number" min="0" step="0.001"/></label></div>
            <div class="field-row">
                @if (Model.IsAdmin) { <label>Kavuran<select asp-for="Input.PersonelId"><option value="">Seçin</option>@foreach (var x in Model.Personeller) { <option value="@x.Id">#@x.Id · @x.Name</option> }</select></label> }
                <label>Kepek <span>kg</span><input asp-for="Input.KepekKg" type="number" min="0" step="0.001"/></label>
            </div>
            <div class="field-row"><label>Ürün<select asp-for="Input.UrunId"><option value="">Seçin</option>@foreach (var x in Model.Urunler) { <option value="@x.Id">@x.Name</option> }</select></label><label>Menşei<select asp-for="Input.MenseiId"><option value="">Seçin</option>@foreach (var x in Model.Menseiler) { <option value="@x.Id">@x.Name</option> }</select></label></div>
            <div class="field-row"><label>Tava sayısı<input asp-for="Input.TavaSayisi" type="number"/></label><label>Arızalı tava<input asp-for="Input.ArizaliTavaSayisi" type="number"/></label></div>
            <div class="field-row"><label>Çıkan sorteks altı <span>kg</span><input asp-for="Input.CikanSorteksAltiKg" type="number" step="0.001"/></label><label>Eklenen sorteks altı <span>kg</span><input asp-for="Input.EklenenSorteksAltiKg" type="number" step="0.001"/></label></div>
            <label>Verim oranı<input asp-for="Input.VerimOrani" type="number" step="0.0001"/></label>
            <label>Açıklama<textarea asp-for="Input.Aciklama" rows="2"></textarea></label>
            <button class="btn-primary-app full">@(Model.EditId is > 0 ? "Değişiklikleri kaydet" : "Kavurma kaydını ekle")</button>
        </form>
    </aside>
</div>
