@page
@model DolumModel
@{ViewData["Title"]="Dolum";}
@if(Model.ErrorMessage is not null){<div class="notice error">@Model.ErrorMessage</div>}
<div class="@(Model.IsAdmin?"workspace-grid":"personnel-entry")">
<section class="data-section"><div class="section-head"><div><h2>Kayıtlar</h2><p>Son 100 dolum işlemi</p></div><span class="count-badge">@Model.Records.Count kayıt</span></div><partial name="Shared/_RecordFilter" model="Model.Filter"/>
<div class="table-wrap"><table class="data-table"><thead><tr><th>Tarih</th><th>Ambalaj</th><th>Tank</th><th class="num">Adet</th><th class="num">Miktar</th><th class="num">Fire Miktarı</th><th></th></tr></thead><tbody>
@foreach(var x in Model.Records){<tr><td>@(x.Tarih?.ToString("dd.MM.yyyy")??"—")</td><td>@x.Ambalaj</td><td>@(x.Tank??"—")</td><td class="num">@x.Adet</td><td class="num"><strong>@x.MiktarKg.ToString("0.###") kg</strong></td><td class="num">@(x.FireKg?.ToString("0.###")??"—") kg</td><td><div class="table-actions"><a class="action-edit" asp-route-editId="@x.Id">Düzenle</a>@if(Model.IsAdmin||x.Id==Model.Records.FirstOrDefault()?.Id){<form method="post" asp-page-handler="Delete" onsubmit="return confirm('Bu kayıt silinsin mi?');"><input type="hidden" name="id" value="@x.Id"/><button class="action-delete">Sil</button></form>}</div></td></tr>}
</tbody></table></div></section>
<aside class="entry-panel"><div class="panel-head"><h2>@(Model.EditId is>0?"Kaydı düzenle":Model.IsAdmin?"Yeni kayıt":"Görev kaydı")</h2><span>@(Model.IsAdmin?"Dolum":Model.PersonnelName)</span></div>
<form method="post" class="entry-form"><input asp-for="EditId" type="hidden"/><div asp-validation-summary="All" class="validation"></div>@if(Model.EditId is>0){<div class="edit-banner"><span>#@Model.EditId numaralı kayıt düzenleniyor</span><a asp-page="/Dolum">İptal</a></div>}
<label>Tarih<input asp-for="Input.Tarih" type="date"/></label><label>Ambalaj<select asp-for="Input.AmbalajId"><option value="">Seçin</option>@foreach(var x in Model.Ambalajlar){<option value="@x.Id">@x.Name · @x.Value?.ToString("0.###") kg</option>}</select></label>
<div class="field-row"><label>Paketleme adedi<input asp-for="Input.PaketlemeAdedi" type="number"/></label><label>Fire Miktarı <span>kg</span><input asp-for="Input.FireKg" type="number" step="0.001"/></label></div>
<div class="field-row"><label>Tank<input asp-for="Input.Tank" placeholder="Örnek: Tank 1" autocomplete="off"/></label>@if(Model.IsAdmin){<label>Personel<select asp-for="Input.PersonelId"><option value="">Seçin</option>@foreach(var x in Model.Personeller){<option value="@x.Id">#@x.Id · @x.Name</option>}</select></label>}</div>
<label>Personel sayısı<input asp-for="Input.PersonelSayisi" type="number"/></label><label>Açıklama<textarea asp-for="Input.Aciklama" rows="3"></textarea></label><button class="btn-primary-app full">@(Model.EditId is>0?"Değişiklikleri kaydet":"Kaydı ekle")</button>
</form></aside></div>
